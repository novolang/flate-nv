// vectors_tests.nv — the decoder against streams a reference
// implementation wrote, and against streams that are wrong on purpose.
//
// The corpus is what CPython's zlib and gzip modules produce for seven
// fixed inputs at compression levels 0, 1, 6 and 9, in the three
// containers; `tests/vectors.py` regenerates it.  The levels matter: 0
// is all stored blocks, 1 and 6 and 9 choose between fixed and dynamic
// codes and between short and long matches differently.  The suite
// carries the bytes as hex, so running it needs nothing outside this
// package.
//
// What the corpus asserts is the correctness condition of the package:
// this decoder inflates what zlib deflates.

use std.test
use flate
use flateerror
use inflate

// One reference stream: which input it holds, its container (0 raw,
// 1 zlib, 2 gzip), the level it was made at and its bytes as hex.
struct Stream
    input: Str
    format: Int
    level: Int
    hex: Str

fn hex(s: Str) -> Bytes
    bytes.from_hex(s) ?? bytes.zeros(0)

fn container(code: Int) -> FlateFormat
    if code == 0
        return RawDeflate
    if code == 1
        return ZlibWrapped
    GzipWrapped

// plain inputs, as hex
fn plain(name: Str) -> Bytes
    if name == "empty"
        return hex("")
    if name == "one"
        return hex("61")
    if name == "hello"
        return hex("68656c6c6f2c2068656c6c6f2c2068656c6c6f2c2068656c6c6f")
    if name == "text"
        return hex("")
    if name == "runs"
        return hex("")
    if name == "noise"
        return hex("")
    if name == "mixed"
        return hex("")
    bytes.zeros(0)

// streams: (name, input, container, level, hex)
fn corpus() -> [Stream]
    var out: [Stream] = []
    list.push(out, Stream { input: "empty", format: 0, level: 0, hex: "010000ffff" })
    list.push(out, Stream { input: "empty", format: 0, level: 1, hex: "0300" })
    list.push(out, Stream { input: "empty", format: 0, level: 6, hex: "0300" })
    list.push(out, Stream { input: "empty", format: 0, level: 9, hex: "0300" })
    list.push(out, Stream { input: "one", format: 0, level: 0, hex: "010100feff61" })
    list.push(out, Stream { input: "one", format: 0, level: 1, hex: "4b0400" })
    list.push(out, Stream { input: "one", format: 0, level: 6, hex: "4b0400" })
    list.push(out, Stream { input: "one", format: 0, level: 9, hex: "4b0400" })
    list.push(out, Stream { input: "hello",
        format: 0,
        level: 0,
        hex: "011a00e5ff68656c6c6f2c2068656c6c6f2c2068656c6c6f2c2068656c6c6f" })
    list.push(out, Stream { input: "hello", format: 0, level: 1, hex: "cb48cdc9c9d751c8c0a400" })
    list.push(out, Stream { input: "hello", format: 0, level: 6, hex: "cb48cdc9c9d751c8c0a400" })
    list.push(out, Stream { input: "hello", format: 0, level: 9, hex: "cb48cdc9c9d751c8c0a400" })
    list.push(out, Stream { input: "text",
        format: 0,
        level: 0,
        hex: "" })
    list.push(out, Stream { input: "text",
        format: 0,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "text",
        format: 0,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "text",
        format: 0,
        level: 9,
        hex: "" })
    list.push(out, Stream { input: "runs",
        format: 0,
        level: 0,
        hex: "" })
    list.push(out, Stream { input: "runs", format: 0, level: 1, hex: "4b4c1c05a321301a02c33d0400" })
    list.push(out, Stream { input: "runs", format: 0, level: 6, hex: "4b4c1c05a360140c770000" })
    list.push(out, Stream { input: "runs", format: 0, level: 9, hex: "4b4c1c05a360140c770000" })
    list.push(out, Stream { input: "noise",
        format: 0,
        level: 0,
        hex: "" })
    list.push(out, Stream { input: "noise",
        format: 0,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "noise",
        format: 0,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "noise",
        format: 0,
        level: 9,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 0,
        level: 0,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 0,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 0,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 0,
        level: 9,
        hex: "" })
    list.push(out, Stream { input: "empty", format: 1, level: 1, hex: "7801030000000001" })
    list.push(out,
        Stream { input: "empty", format: 2, level: 1, hex: "1f8b080000000000040303000000000000000000" })
    list.push(out, Stream { input: "empty", format: 1, level: 6, hex: "789c030000000001" })
    list.push(out,
        Stream { input: "empty", format: 2, level: 6, hex: "1f8b080000000000000303000000000000000000" })
    list.push(out, Stream { input: "empty", format: 1, level: 9, hex: "78da030000000001" })
    list.push(out,
        Stream { input: "empty", format: 2, level: 9, hex: "1f8b080000000000020303000000000000000000" })
    list.push(out, Stream { input: "text",
        format: 1,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "text",
        format: 2,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "text",
        format: 1,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "text",
        format: 2,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "text",
        format: 1,
        level: 9,
        hex: "" })
    list.push(out, Stream { input: "text",
        format: 2,
        level: 9,
        hex: "" })
    list.push(out,
        Stream { input: "runs", format: 1, level: 1, hex: "78014b4c1c05a321301a02c33d0400f9d87af8" })
    list.push(out, Stream { input: "runs",
        format: 2,
        level: 1,
        hex: "1f8b08000000000004034b4c1c05a321301a02c33d040003da389ae8030000" })
    list.push(out, Stream { input: "runs", format: 1, level: 6, hex: "789c4b4c1c05a360140c770000f9d87af8" })
    list.push(out, Stream { input: "runs",
        format: 2,
        level: 6,
        hex: "1f8b08000000000000034b4c1c05a360140c77000003da389ae8030000" })
    list.push(out, Stream { input: "runs", format: 1, level: 9, hex: "78da4b4c1c05a360140c770000f9d87af8" })
    list.push(out, Stream { input: "runs",
        format: 2,
        level: 9,
        hex: "1f8b08000000000002034b4c1c05a360140c77000003da389ae8030000" })
    list.push(out, Stream { input: "noise",
        format: 1,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "noise",
        format: 2,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "noise",
        format: 1,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "noise",
        format: 2,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "noise",
        format: 1,
        level: 9,
        hex: "" })
    list.push(out, Stream { input: "noise",
        format: 2,
        level: 9,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 1,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 2,
        level: 1,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 1,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 2,
        level: 6,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 1,
        level: 9,
        hex: "" })
    list.push(out, Stream { input: "mixed",
        format: 2,
        level: 9,
        hex: "" })
    out

// Decode `data` by feeding it `step` bytes at a time.
fn in_pieces(data: Bytes, fmt: FlateFormat, step: Int) -> Result<Bytes, FlateError>
    var d = inflate.inflater(fmt)
    var parts: [Bytes] = []
    var at = 0
    let n = bytes.len(data)
    while at < n
        var to = at + step
        if to > n
            to = n
        let (next, out) = inflate.feed(d, bytes.slice(data, at, to))
        d = next
        list.push(parts, bytes.clone(out))
        at = to
    match inflate.finish(d)
        Ok(tail) =>
            list.push(parts, bytes.clone(tail))
            Ok(bytes.concat(parts))
        Err(e)   => Err(e)

fn same(r: Result<Bytes, FlateError>, want: Bytes) -> Bool
    match r
        Ok(got) => got == want
        Err(_)  => false

@test
fn test_the_whole_corpus_decodes() [io]
    for s in corpus()
        test.case("${s.input}, format ${s.format}, level ${s.level}")
        test.assert(same(inflate.decompress(hex(s.hex), container(s.format)), plain(s.input)))

@test
fn test_the_corpus_decodes_in_pieces_of_any_size() [io]
    for s in corpus()
        let want = plain(s.input)
        let data = hex(s.hex)
        test.case("${s.input}, format ${s.format}, level ${s.level}, one byte at a time")
        test.assert(same(in_pieces(data, container(s.format), 1), want))
        test.case("${s.input}, format ${s.format}, level ${s.level}, three at a time")
        test.assert(same(in_pieces(data, container(s.format), 3), want))
        test.case("${s.input}, format ${s.format}, level ${s.level}, thirteen at a time")
        test.assert(same(in_pieces(data, container(s.format), 13), want))

@test
fn test_a_decoder_reports_how_much_it_consumed_and_produced() [io]
    for s in corpus()
        test.case("${s.input}, format ${s.format}, level ${s.level}")
        let data = hex(s.hex)
        let (d, out) = inflate.feed(inflate.inflater(container(s.format)), data)
        test.assert(inflate.is_done(d))
        test.assert(inflate.total_in(d) == bytes.len(data))
        test.assert(inflate.total_out(d) == bytes.len(out))
        test.assert(bytes.len(out) == bytes.len(plain(s.input)))

@test
fn test_every_proper_prefix_of_a_stream_is_truncated() [io]
    for s in corpus()
        if s.level == 6 and s.input != "empty"
            let data = hex(s.hex)
            test.case("${s.input}, format ${s.format}")
            for cut in 0..bytes.len(data)
                match inflate.decompress(bytes.slice(data, 0, cut), container(s.format))
                    Err(TruncatedStream(off)) => test.assert(off == cut)
                    Err(_)                    => test.fail("a prefix of ${cut} byte(s) was refused for another reason")
                    Ok(_)                     => test.fail("a prefix of ${cut} byte(s) decoded")

@test
fn test_the_header_of_a_gzip_member_is_available_once_it_has_arrived() [io]
    let member = hex(find_hex(2, 6, "text"))
    test.case("not before the header")
    let (d0, _) = inflate.feed(inflate.inflater(GzipWrapped), bytes.slice(member, 0, 9))
    test.assert(inflate.gzip_header(d0) == None)
    test.case("after it")
    let (d1, _) = inflate.feed(d0, bytes.slice(member, 9, 12))
    match inflate.gzip_header(d1)
        Some(h) => test.assert(h.mtime == 0)
        None    => test.fail("no header after 12 bytes")

fn find_hex(format: Int, level: Int, input: Str) -> Str
    for s in corpus()
        if s.format == format and s.level == level and s.input == input
            return s.hex
    ""

@test
fn test_the_zlib_header_is_available_once_it_has_arrived() [io]
    let data = hex(find_hex(1, 6, "text"))
    let (d0, _) = inflate.feed(inflate.inflater(ZlibWrapped), bytes.slice(data, 0, 1))
    test.assert(inflate.zlib_header(d0) == None)
    let (d1, _) = inflate.feed(d0, bytes.slice(data, 1, 3))
    match inflate.zlib_header(d1)
        Some(h) =>
            test.assert(h.window_bits == 15)
            test.assert(h.level_hint == 2)
        None    => test.fail("no header after 3 bytes")
