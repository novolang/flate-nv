// gzip.nv — RFC 1952's header and trailer as values, separately from
// the stream they wrap.
//
// WHY THE HEADER IS ITS OWN VALUE
//
// A gzip member is a header, a DEFLATE stream and a trailer, and only
// the middle one is compression.  Making the header a value the caller
// can build, read, parse and emit on its own buys three things the
// interface would otherwise have to invent workarounds for:
//
//   · a caller unpacking a `.gz` learns the original file name from
//     `inflate.gzip_header` before the body arrives, and can create the
//     output file with the right name;
//   · a caller writing one sets the name and the modification time,
//     which is the difference between a `.gz` that round-trips through
//     `gunzip` and one that unpacks to `noname`;
//   · a caller SCANNING a multi-member file — every `.gz` produced by
//     `cat a.gz b.gz` is one — parses headers without decompressing.
//
// The alternative shape, options on the encoder, was rejected because
// it makes the header write-only: there is no way to hand a parsed one
// back.
//
// WHAT IS THE SPECIFICATION AND WHAT IS GZIP'S CHOICE
//
// The field layout, the magic `1f 8b`, CM = 8, the flag bits and the
// little-endian trailer are RFC 1952 and binding.  The DEFAULTS this
// module hands out are not: `mtime = 0` (RFC 1952 § 2.3.1's "no time
// available"), OS = 255 (unknown) rather than 3 (Unix), and no header
// CRC.  gzip(1) writes the real mtime and the real OS; this package
// will not read a clock, because it is `core` and has no clock to
// read, and a caller who wants the real one passes it in.  That is the
// single sharpest place where the sans-IO rule shows through the
// interface, and the README says so.

use flateerror
use flatecheck

// A gzip member's header, RFC 1952 § 2.3.
//
// Every field is typed rather than packed into a byte array: the flag
// byte becomes the three booleans and the three optional fields it
// gates, so a caller neither builds nor reads a bit mask.  The flag
// byte is reconstructed by `emit` from what is present.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${gzip.header().mtime}")                // 0
// ```
pub struct GzipHeader
    // Modification time as a Unix timestamp, or 0 for "none
    // available" (RFC 1952 § 2.3.1).  Zero is the default because a
    // `core` package cannot read a clock — a caller who wants the real
    // time passes it to `with_mtime`.
    mtime: Int
    // The XFL byte: 2 for the slowest compression, 4 for the fastest,
    // 0 otherwise.  An encoder sets it from its level; a decoder
    // ignores it, and so should you.
    xfl: Int
    // The OS byte: 3 is Unix, 0 is FAT, 255 is unknown, and unknown is
    // the default here because this package does not know what it is
    // running on and will not guess.
    os: Int
    // The original file name, without a directory, in Latin-1 as RFC
    // 1952 § 2.3.1 requires; empty for none.  It is what `gunzip`
    // names the output file.
    name: Str
    // A human-readable comment, in Latin-1; empty for none.
    comment: Str
    // The FEXTRA field's contents, as its own subfield-structured
    // bytes; empty for none.  This package does not parse the
    // subfields — that is a per-application registry (`RA` for random
    // access, `BC` for bgzip) that belongs where the application is.
    extra: Bytes
    // The FTEXT hint: the member is probably text.  Advisory, ignored
    // by every decompressor, and false by default.
    is_text: Bool
    // Whether the header carries a CRC16 of itself (FHCRC).  Rare,
    // and off by default because most tools do not write it and some
    // older ones mis-read it.
    has_header_crc: Bool

// A header with nothing set: no name, no comment, no extra field, no
// time, unknown OS.
//
// The minimum a valid gzip member needs, and what `deflate.deflater`
// uses under `GzipWrapped` unless told otherwise.  Ten bytes on the
// wire.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${gzip.header().os}")                   // 255
// ```
pub fn header() -> GzipHeader
    GzipHeader { mtime: 0, xfl: 0, os: 255, name: "", comment: "",
                 extra: bytes.zeros(0), is_text: false, has_header_crc: false }

// The header with its original file name set.
//
// The name is a BASE name — RFC 1952 § 2.3.1 says directory components
// are stripped, and a decompressor that honoured a path in it would
// have a directory-traversal hole.  This package does not enforce that
// on the way in, because it does not know what a path looks like on
// the caller's machine, and it does not have one; a caller extracting
// to disk sanitises what `inflate.gzip_header` gave it, and the README
// says so in as many words.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${gzip.with_name(gzip.header(), "notes.txt").name}")
// ```
pub fn with_name(h: GzipHeader, name: Str) -> GzipHeader
    GzipHeader { mtime: h.mtime, xfl: h.xfl, os: h.os, name: name,
                 comment: h.comment, extra: h.extra, is_text: h.is_text,
                 has_header_crc: h.has_header_crc }

// The header with a comment set.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${gzip.with_comment(gzip.header(), "built by novo-lang").comment}")
// ```
pub fn with_comment(h: GzipHeader, comment: Str) -> GzipHeader
    GzipHeader { mtime: h.mtime, xfl: h.xfl, os: h.os, name: h.name,
                 comment: comment, extra: h.extra, is_text: h.is_text,
                 has_header_crc: h.has_header_crc }

// The header with a modification time set.
//
// A Unix timestamp the caller supplies, because this package has no
// clock: `core` means no `[time]`, and the alternative — an encoder
// that reached for the wall clock — is exactly the effect the layer
// forbids.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${gzip.with_mtime(gzip.header(), 1757376000).mtime}")
// ```
pub fn with_mtime(h: GzipHeader, mtime: Int) -> GzipHeader
    GzipHeader { mtime: mtime, xfl: h.xfl, os: h.os, name: h.name,
                 comment: h.comment, extra: h.extra, is_text: h.is_text,
                 has_header_crc: h.has_header_crc }

// The header with an OS byte set.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${gzip.with_os(gzip.header(), 3).os}")   // 3 — Unix
// ```
pub fn with_os(h: GzipHeader, os: Int) -> GzipHeader
    GzipHeader { mtime: h.mtime, xfl: h.xfl, os: os, name: h.name,
                 comment: h.comment, extra: h.extra, is_text: h.is_text,
                 has_header_crc: h.has_header_crc }

// The header with an FEXTRA field set.
//
// The bytes are written through unexamined.  RFC 1952 § 2.3.1.1 gives
// them a subfield structure and an application registry, and neither
// is this package's business.
//
// ```novo
// use gzip
//
// fn main() [io]
//     let h = gzip.with_extra(gzip.header(), bytes.from_str(""))
//     println("${bytes.len(h.extra)}")                  // 0
// ```
pub fn with_extra(h: GzipHeader, extra: Bytes) -> GzipHeader
    GzipHeader { mtime: h.mtime, xfl: h.xfl, os: h.os, name: h.name,
                 comment: h.comment, extra: extra, is_text: h.is_text,
                 has_header_crc: h.has_header_crc }

// The header with the FTEXT hint set or cleared.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${gzip.with_text(gzip.header(), true).is_text}")     // true
// ```
pub fn with_text(h: GzipHeader, is_text: Bool) -> GzipHeader
    GzipHeader { mtime: h.mtime, xfl: h.xfl, os: h.os, name: h.name,
                 comment: h.comment, extra: h.extra, is_text: is_text,
                 has_header_crc: h.has_header_crc }

// The header with the FHCRC self-check turned on or off.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${gzip.with_header_crc(gzip.header(), true).has_header_crc}")   // true
// ```
pub fn with_header_crc(h: GzipHeader, on: Bool) -> GzipHeader
    GzipHeader { mtime: h.mtime, xfl: h.xfl, os: h.os, name: h.name,
                 comment: h.comment, extra: h.extra, is_text: h.is_text,
                 has_header_crc: on }

// Parse a header from the front of a buffer: the header, and how many
// bytes it took.
//
// The length matters as much as the header — a gzip header is between
// ten bytes and megabytes depending on its optional fields, so a
// caller scanning a multi-member file has no other way to find where
// the DEFLATE stream starts.
//
// `TruncatedStream` when the buffer ends inside the header, which is
// how a caller feeding a stream knows to come back with more rather
// than to give up.
//
// ```novo
// use gzip
//
// fn main() [io]
//     match gzip.parse(bytes.from_str(""))
//         Ok(_)  => println("parsed")
//         Err(_) => println("need more bytes")         // this one
// ```
pub fn parse(data: Bytes) -> Result<(GzipHeader, Int), FlateError>
    let n = bytes.len(data)
    if n >= 1 and byte_of(data, 0) != 0x1F
        return Err(BadGzipMagic(0, magic_seen(data)))
    if n >= 2 and byte_of(data, 1) != 0x8B
        return Err(BadGzipMagic(0, magic_seen(data)))
    if n < 4
        return Err(TruncatedStream(n))
    if byte_of(data, 2) != 8
        return Err(BadGzipMethod(2, byte_of(data, 2)))
    if n < 10
        return Err(TruncatedStream(n))
    let flags = byte_of(data, 3)
    var at = 10
    var extra = bytes.zeros(0)
    if (flags & FEXTRA) != 0
        if n < at + 2
            return Err(TruncatedStream(n))
        let xlen = byte_of(data, at) | (byte_of(data, at + 1) << 8)
        at = at + 2
        if n < at + xlen
            return Err(TruncatedStream(n))
        extra = bytes.slice(data, at, at + xlen)
        at = at + xlen
    var name = ""
    if (flags & FNAME) != 0
        let end = bytes.find_byte(data, 0, at) ?? -1
        if end < 0
            return Err(TruncatedStream(n))
        name = bytes.to_str(bytes.slice(data, at, end))
        at = end + 1
    var comment = ""
    if (flags & FCOMMENT) != 0
        let end = bytes.find_byte(data, 0, at) ?? -1
        if end < 0
            return Err(TruncatedStream(n))
        comment = bytes.to_str(bytes.slice(data, at, end))
        at = end + 1
    if (flags & FHCRC) != 0
        if n < at + 2
            return Err(TruncatedStream(n))
        let want = byte_of(data, at) | (byte_of(data, at + 1) << 8)
        let got = flatecheck.crc32_of(bytes.slice(data, 0, at)) & 0xFFFF
        if want != got
            return Err(BadGzipHeaderCrc(at, want, got))
        at = at + 2
    let xfl = byte_of(data, 8)
    let mtime = bytes.u32_le_at(data, 4) ?? 0
    let h = GzipHeader { mtime: mtime, xfl: xfl, os: byte_of(data, 9),
                         name: name, comment: comment, extra: extra,
                         is_text: (flags & FTEXT) != 0,
                         has_header_crc: (flags & FHCRC) != 0 }
    Ok((h, at))

// The header, as the bytes that go on the wire.
//
// The flag byte is reconstructed from what is present: FNAME when the
// name is non-empty, FCOMMENT when the comment is, FEXTRA when the
// extra field is, plus FTEXT and FHCRC as the two booleans say.  A
// caller therefore cannot produce a header whose flags and fields
// disagree, which is the one corruption a hand-built gzip header
// usually has.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${bytes.len(gzip.emit(gzip.header()))}")     // 10
// ```
pub fn emit(h: GzipHeader) -> Bytes
    var flags = 0
    if h.is_text
        flags = flags | FTEXT
    if h.has_header_crc
        flags = flags | FHCRC
    var extra = bytes.slice(h.extra, 0, min_len(bytes.len(h.extra), 65535))
    if bytes.len(extra) > 0
        flags = flags | FEXTRA
    let name = bytes.from_str(h.name)
    let name_len = bytes.find_byte(name, 0, 0) ?? bytes.len(name)
    if name_len > 0
        flags = flags | FNAME
    let comment = bytes.from_str(h.comment)
    let comment_len = bytes.find_byte(comment, 0, 0) ?? bytes.len(comment)
    if comment_len > 0
        flags = flags | FCOMMENT
    var parts: [Bytes] = []
    list.push(parts, bytes.concat([bytes.u8(0x1F), bytes.u8(0x8B), bytes.u8(8),
                                   bytes.u8(flags), bytes.u32_le(h.mtime),
                                   bytes.u8(h.xfl), bytes.u8(h.os)]))
    if bytes.len(extra) > 0
        list.push(parts, bytes.u16_le(bytes.len(extra)))
        list.push(parts, bytes.clone(extra))
    if name_len > 0
        list.push(parts, bytes.slice(name, 0, name_len))
        list.push(parts, bytes.u8(0))
    if comment_len > 0
        list.push(parts, bytes.slice(comment, 0, comment_len))
        list.push(parts, bytes.u8(0))
    let body = bytes.concat(parts)
    if h.has_header_crc
        return bytes.concat([body, bytes.u16_le(flatecheck.crc32_of(body))])
    body

// A gzip trailer: the CRC32 of the plaintext and its length modulo
// 2^32, eight little-endian bytes.
//
// `isize` is deliberately taken modulo rather than refused: RFC 1952
// § 2.3.1 defines the field that way, and a member larger than 4 GiB
// is legal and common.  A caller verifying the field compares modulo
// too, and `inflate.finish` does.
//
// ```novo
// use gzip
//
// fn main() [io]
//     println("${bytes.len(gzip.trailer(0, 0))}")           // 8
// ```
pub fn trailer(crc: Int, isize: Int) -> Bytes
    bytes.concat([bytes.u32_le(crc), bytes.u32_le(isize)])

// Parse a trailer at an offset: the CRC32 and the length it claims.
//
// Separate from `parse` because they are at opposite ends of the
// member and a streaming caller reaches them at very different times.
//
// ```novo
// use gzip
//
// fn main() [io]
//     match gzip.parse_trailer(bytes.from_str(""), 0)
//         Ok(_)  => println("read")
//         Err(_) => println("truncated")               // this one
// ```
pub fn parse_trailer(data: Bytes, offset: Int) -> Result<(Int, Int), FlateError>
    let crc = bytes.u32_le_at(data, offset)
    let isize = bytes.u32_le_at(data, offset + 4)
    match (crc, isize)
        (Some(c), Some(s)) => Ok((c, s))
        _                  => Err(TruncatedStream(bytes.len(data)))

// The FLG bits of RFC 1952 section 2.3.1.  The three reserved high bits
// are neither read nor written.
const FTEXT = 1
const FHCRC = 2
const FEXTRA = 4
const FNAME = 8
const FCOMMENT = 16

// The byte at an offset that is known to be inside the buffer.
fn byte_of(data: Bytes, i: Int) -> Int
    bytes.byte_at(data, i) ?? 0

// The two bytes a buffer starts with, as one 16-bit value, with a
// missing second byte read as zero.
fn magic_seen(data: Bytes) -> Int
    (byte_of(data, 0) << 8) | byte_of(data, 1)

// The smaller of two lengths.
fn min_len(a: Int, b: Int) -> Int
    if a < b
        return a
    b
